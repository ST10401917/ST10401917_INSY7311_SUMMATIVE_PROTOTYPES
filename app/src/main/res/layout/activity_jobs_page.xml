<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".JobsPage">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#1400CC"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/find_jobs"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Search Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:autofillHints=""
            android:background="@color/white"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:autofillHints=""
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search3"
                android:layout_marginStart="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:tint="#555555" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/search_jobs"
                android:inputType="text"
                android:paddingStart="8dp"
                android:textColorHint="#757575"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivSearch"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="Autofill,RtlSymmetry,VisualLintTextFieldSize" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- ===== FILTER CHIPS ===== -->
    <HorizontalScrollView
        android:id="@+id/filterChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp"
        android:background="#EFEFEF"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- All Jobs - selected (blue pill) -->
            <TextView
                android:id="@+id/chipAllJobs"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/all_jobs"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@color/blue"
                android:layout_marginEnd="10dp" />

            <!-- Part-time - unselected (grey pill) -->
            <TextView
                android:id="@+id/chipPartTime"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/part_time"
                android:textColor="#444444"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:layout_marginEnd="10dp" />

            <!-- Full-time - unselected (grey pill) -->
            <TextView
                android:id="@+id/chipFullTime"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/full_time1"
                android:textColor="#444444"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- ===== JOB CARDS SCROLL ===== -->
    <ScrollView
        android:id="@+id/scrollJobs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:paddingTop="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/filterChips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- ===== JOB CARD 1: Weekend Retail Assistant ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardJob1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weekend_retail_assistant1"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#111111" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pick_n_pay1"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/part_time_contract"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginTop="2dp" />

                    <Button
                        android:id="@+id/btnApply1"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="#1400CC"
                        android:stateListAnimator="@null"
                        android:text="@string/apply_now1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="22dp"
                        tools:ignore="DuplicateSpeakableTextCheck,VisualLintButtonSize" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== JOB CARD 2: Varsity College Math Tutor ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardJob2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/varsity_college_math_tutor"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#111111" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/iie_emeris_college"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/part_time_contract1"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginTop="2dp" />

                    <Button
                        android:id="@+id/btnApply2"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="#1400CC"
                        android:stateListAnimator="@null"
                        android:text="@string/apply_now2"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="22dp"
                        tools:ignore="VisualLintButtonSize" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== JOB CARD 3: Carsales Person ===== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardJob3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/carsales_person"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#111111" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/j_amp_s_autosales"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/full_time"
                        android:textSize="13sp"
                        android:textColor="#555555"
                        android:layout_marginTop="2dp" />

                    <Button
                        android:id="@+id/btnApply3"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/apply_now"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#1400CC"
                        app:cornerRadius="22dp"
                        android:stateListAnimator="@null"
                        android:layout_marginTop="14dp"
                        tools:ignore="VisualLintButtonSize" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- ===== BOTTOM NAVIGATION ===== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="#1400CC"
        app:itemTextColor="#1400CC"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="VisualLintBottomNav" />

</androidx.constraintlayout.widget.ConstraintLayout>